# Settings for the DLNA bridge. Restart it after a change:
#   sudo systemctl restart dlna-bridge

# The Channels DVR, as this machine reaches it.
DLNA_DVR=http://localhost:8089

# The name the TVs list.
#DLNA_NAME=Channels DVR

# The address to announce, when this machine has several and TVs pick the wrong one.
#DLNA_ADVERTISE=192.168.1.10

# Where to find ffmpeg, for clients set to "Converted" on the settings page.
#DLNA_FFMPEG=/usr/bin/ffmpeg

# The other settings, and the clients, are on the settings page: http://THIS-MACHINE:8200/
